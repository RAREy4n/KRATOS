# Conexão com o MongoDB Atlas
# Formato: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URI=mongodb+srv://seu-usuario:sua-senha@cluster.mongodb.net/kidquest

# Chave secreta para assinar os tokens JWT
# Use uma string longa e aleatória em produção
JWT_SECRET=troque-isso-por-algo-seguro-em-producao

# Porta do servidor (opcional, padrão: 3001)
PORT=3001

# URLs permitidas no CORS (separadas por vírgula)
# Desenvolvimento: http://localhost:5173
# Produção: coloque as URLs do Vercel dos frontends
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
